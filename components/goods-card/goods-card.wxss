.goods-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.thumb {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-emoji {
  font-size: 120rpx;
}

.info {
  padding: 16rpx 20rpx 20rpx;
}

.title {
  font-size: 28rpx;
  line-height: 38rpx;
  color: #222;
  min-height: 76rpx;
}

.tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  color: #FF5000;
  border: 1rpx solid rgba(255, 80, 0, 0.5);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-right: 8rpx;
}

.price-row {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
}

.price .decimal {
  font-size: 28rpx;
}

.meta-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
}

.sales {
  flex-shrink: 0;
}

.shop {
  margin-left: 12rpx;
  max-width: 200rpx;
}
