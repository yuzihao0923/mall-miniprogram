page {
  height: 100%;
  overflow: hidden;
}

.page {
  display: flex;
  height: 100vh;
}

/* ===== 左侧分类 ===== */
.aside {
  width: 180rpx;
  flex-shrink: 0;
  background: #f7f7f7;
  height: 100%;
}

.aside-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: #555;
}

.aside-item-active {
  background: #fff;
  color: #FF5000;
  font-weight: 600;
}

.aside-bar {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 48rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: #FF5000;
}

.aside-emoji {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

/* ===== 右侧商品 ===== */
.content {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: #fff;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx;
}

.grid-col {
  flex: 1;
  min-width: 0;
}

.grid-col:first-child {
  margin-right: 16rpx;
}
