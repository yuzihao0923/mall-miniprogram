.page {
  padding-bottom: 0;
}

/* ===== 顶部图集 ===== */
.gallery {
  position: relative;
}

.gallery-swiper {
  height: 750rpx;
}

.gallery-item {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-emoji {
  font-size: 300rpx;
}

.gallery-index {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

/* ===== 卡片通用 ===== */
.price-card,
.title-card,
.service-card,
.shop-card,
.detail-section {
  margin: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

/* ===== 价格区 ===== */
.price-row {
  display: flex;
  align-items: baseline;
}

.price .integer.big {
  font-size: 52rpx;
}

.price-badge {
  margin-left: auto;
  font-size: 22rpx;
  color: #999;
}

.promo {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #FF5000;
  background: #fff3ec;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
}

/* ===== 标题 ===== */
.title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 46rpx;
}

.tag-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  color: #FF5000;
  border: 1rpx solid rgba(255, 80, 0, 0.5);
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
  margin-right: 10rpx;
}

.ship-row {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #888;
}

/* ===== 服务保障 ===== */
.service-card {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.service-item {
  font-size: 24rpx;
  color: #555;
}

.service-emoji {
  margin-right: 6rpx;
}

/* ===== 店铺 ===== */
.shop-card {
  display: flex;
  align-items: center;
}

.shop-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF7000, #FF5000);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.shop-info {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.shop-name {
  font-size: 28rpx;
  font-weight: 600;
}

.shop-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.shop-btn {
  border: 1rpx solid #FF5000;
  color: #FF5000;
  font-size: 24rpx;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
}

/* ===== 图文详情 ===== */
.detail-title {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.detail-img {
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-img-emoji {
  font-size: 160rpx;
}

.detail-text {
  font-size: 26rpx;
  color: #666;
  line-height: 42rpx;
}

.bottom-placeholder {
  height: 130rpx;
}

/* ===== 底部操作栏 ===== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.action-icon {
  position: relative;
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-emoji {
  font-size: 40rpx;
}

.action-label {
  font-size: 20rpx;
  color: #666;
  margin-top: 2rpx;
}

.action-badge {
  position: absolute;
  top: -8rpx;
  right: 8rpx;
  background: #FF5000;
  color: #fff;
  font-size: 18rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 999rpx;
  padding: 0 6rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-cart {
  background: linear-gradient(90deg, #FFA033, #FF7000);
  border-radius: 999rpx 0 0 999rpx;
}

.btn-buy {
  background: linear-gradient(90deg, #FF5000, #F0233B);
  border-radius: 0 999rpx 999rpx 0;
}
