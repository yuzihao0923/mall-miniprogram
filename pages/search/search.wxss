.page {
  padding: 16rpx;
}

/* ===== 搜索框 ===== */
.search-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  height: 68rpx;
  padding: 0 28rpx;
  border: 1rpx solid #eee;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.search-btn {
  margin-left: 20rpx;
  color: #FF5000;
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== 分区 ===== */
.section {
  margin-bottom: 36rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.section-clear {
  font-size: 24rpx;
  color: #999;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  background: #fff;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  color: #555;
  margin: 0 16rpx 16rpx 0;
}

.tag-hot {
  display: flex;
  align-items: center;
}

.tag-rank {
  color: #FF5000;
  font-weight: 700;
  font-style: italic;
  margin-right: 8rpx;
}

/* ===== 结果 ===== */
.result-bar {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.result-count {
  color: #FF5000;
  font-weight: 600;
}

.waterfall {
  display: flex;
}

.column {
  flex: 1;
  min-width: 0;
}

.column:first-child {
  margin-right: 16rpx;
}

.load-more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 24rpx 0 40rpx;
}
