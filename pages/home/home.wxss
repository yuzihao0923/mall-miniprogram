.page {
  padding: 16rpx 16rpx 0;
}

/* ===== 搜索栏 ===== */
.search-bar {
  padding-bottom: 16rpx;
}

.search-input {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  height: 64rpx;
  padding: 0 28rpx;
  border: 1rpx solid #eee;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  color: #aaa;
  font-size: 26rpx;
}

/* ===== 轮播 ===== */
.banner {
  height: 260rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-item {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 48rpx;
}

.banner-text {
  color: #fff;
}

.banner-title {
  font-size: 38rpx;
  font-weight: 700;
}

.banner-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.banner-emoji {
  font-size: 120rpx;
}

/* ===== 金刚区 ===== */
.kingkong {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 0 8rpx;
}

.kingkong-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.kingkong-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff3ec;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.kingkong-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #444;
}

/* ===== 分类 chips ===== */
.chips {
  margin-top: 16rpx;
  white-space: nowrap;
}

.chip {
  display: inline-block;
  padding: 10rpx 30rpx;
  margin-right: 14rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #555;
}

.chip-active {
  background: linear-gradient(90deg, #FF7000, #FF5000);
  color: #fff;
  font-weight: 600;
}

/* ===== 瀑布流 ===== */
.waterfall {
  margin-top: 16rpx;
  display: flex;
}

.column {
  flex: 1;
  min-width: 0;
}

.column:first-child {
  margin-right: 16rpx;
}

/* ===== 加载状态 ===== */
.load-more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 24rpx 0 40rpx;
}
