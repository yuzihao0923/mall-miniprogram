# ===== 支付服务端环境变量模板 =====
# 复制为 server/.env 并填入真实值（.env 已被 .gitignore 排除，不会提交）

# 小程序凭据：MP 后台「开发 → 开发管理 → 开发设置」
WX_APPID=wx1234567890abcdef
WX_APPSECRET=your_app_secret_here

# 虚拟支付：MP 后台「功能 → 虚拟支付」页
WPAY_OFFER_ID=your_offer_id
WPAY_APPKEY=your_pay_appkey_here

# 支付环境：production=正式 / sandbox=沙箱（signData.env=1）
WPAY_ENV=sandbox

# 服务端口
PORT=3000

# 兜底查单定时器（建议保持开启，每 5 分钟一轮）
PAY_POLL_ENABLED=true
PAY_POLL_INTERVAL_MS=300000
