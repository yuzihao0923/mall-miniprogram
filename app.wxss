/* ===== 全局样式 ===== */
page {
  background: #f4f4f4;
  font-size: 28rpx;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  box-sizing: border-box;
}

view, text, image, button {
  box-sizing: border-box;
}

/* 通用白卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 单行省略 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 多行省略 */
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 价格：橙红主色，分单位小号 */
.price {
  color: #FF5000;
  font-weight: 600;
}
.price .symbol {
  font-size: 24rpx;
}
.price .integer {
  font-size: 34rpx;
}

/* 原价删除线 */
.price-origin {
  color: #999;
  font-size: 22rpx;
  text-decoration: line-through;
  margin-left: 8rpx;
}

/* 橙色主按钮 */
.btn-primary {
  background: linear-gradient(90deg, #FF7000, #FF5000);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 20rpx 0;
}

/* 精灵球图标（纯 CSS）：尺寸随父级 font-size（em）缩放 */
.pokeball {
  position: relative;
  display: inline-block;
  width: 1.15em;
  height: 1.15em;
  border-radius: 50%;
  box-sizing: border-box;
  border: 0.045em solid #2f2f2f;
  background: linear-gradient(to bottom, #e8443f 0 40%, #2f2f2f 40% 48%, #fbfbfb 48% 100%);
  box-shadow: inset -0.06em -0.06em 0.1em rgba(0, 0, 0, 0.15);
}

.pokeball::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 34%;
  height: 34%;
  border-radius: 50%;
  background: #fff;
  border: 0.05em solid #2f2f2f;
  box-sizing: border-box;
}

/* 通用空状态 */
.empty {
  padding: 160rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}
.empty .empty-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}
